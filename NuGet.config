<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- v2 endpoint is used because api.nuget.org (v3) is unreachable from some networks;
         the v2 endpoint is universally reachable and fully supported by NuGet restore. -->
    <add key="nuget.org-v2" value="https://www.nuget.org/api/v2/" protocolVersion="2" />
  </packageSources>
</configuration>
